[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
macos.debug = "res://rust/target/debug/libashfall_core.dylib"
macos.release = "res://rust/target/release/libashfall_core.dylib"
linux.debug.x86_64 = "res://rust/target/debug/libashfall_core.so"
linux.release.x86_64 = "res://rust/target/release/libashfall_core.so"
windows.debug.x86_64 = "res://rust/target/debug/ashfall_core.dll"
windows.release.x86_64 = "res://rust/target/x86_64-pc-windows-gnu/release/ashfall_core.dll"
